# ==============================================================================
# Dockerfile для локальной разработки Frontend (Vite dev-server)
# ==============================================================================

FROM node:20-alpine

# Рабочая директория
WORKDIR /app

# Копируем package.json и package-lock.json для кэширования слоёв
COPY package.json package-lock.json ./

# Устанавливаем зависимости
RUN npm ci

# Копируем исходный код
COPY . .

# Открываем порт 5173 (Vite dev-server)
EXPOSE 5173

# Запускаем Vite dev-server с hot-reload
CMD ["npm", "run", "dev", "--", "--host"]
