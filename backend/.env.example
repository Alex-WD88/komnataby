# ==============================================================================
# Переменные окружения для Django-бэкенда
# ==============================================================================
# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
# ==============================================================================

# --- Безопасность ---
# СЕКРЕТНЫЙ КЛЮЧ Django.
# Для генерации: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here-generate-with-command-above

# ВКЛЮЧАТЬ ЛИ ОТЛАДКУ (False для продакшена!)
DJANGO_DEBUG=False

# РАЗРЕШЁННЫЕ ХОСТЫ (через запятую, без пробелов)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS ---
# РАЗРЕШИТЬ ВСЕ ИСТОЧНИКИ (False для продакшена!)
DJANGO_CORS_ALLOW_ALL=False

# РАЗРЕШЁННЫЕ ИСТОЧНИКИ (через запятую)
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- База данных (PostgreSQL) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=komnata_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
